# --- Supabase (создаётся в вашем аккаунте) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon | publishable key>

# Service role — только на сервере. Нужен для админ-операций (создание пользователей)
# и для внешнего API выгрузки. НИКОГДА не добавлять префикс NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Ключ для внешнего API выгрузки данных (/api/v1/*) — для Grok / Gemini / BI
CRM_API_KEY=<придумайте длинный случайный ключ>
